{
	"name": "understand-computers",
	"version": "0.1.0",
	"private": true,
	"license": "AGPL-3.0-or-later",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"theme": "node --env-file-if-exists=.env scripts/theme.mjs static/theme.css",
		"predev": "npm run theme",
		"dev": "vite dev",
		"prebuild": "npm run theme",
		"build": "vite build",
		"preview": "node scripts/serve-build.mjs",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --check . && eslint . && node scripts/verify-source.mjs",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:build": "node scripts/verify-build.mjs",
		"pretest:e2e": "playwright install chromium",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.1",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.65.1",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.4.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.2",
		"@types/node": "^26.6.10",
		"eslint": "^10.15.0",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.2.0",
		"svelte": "^5.59.1",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.74.0",
		"vite": "^8.3.8",
		"vitest": "^5.1.2"
	}
}
